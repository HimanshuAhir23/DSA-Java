class Solution {
    public int maxProduct(int n) {
        int count = 0;
        int temp=n;

     
        while (temp != 0) {
            count++;
            temp/= 10;
           
        }
        int [] arr=new int[count];
        int i=0;
        temp=n;
        while(temp !=0){
        arr[i++]=temp%10;
        temp/=10;
        }
        
      int ans = 0;

        for (int k = 0; k < count; k++) {
            for (int j = k + 1; j < count; j++) {
                ans = Math.max(ans, arr[k] * arr[j]);
            }
        }

        return ans;
        
        
    }
}
