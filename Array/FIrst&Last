
class Solution {
    public int[] searchRange(int[] arr, int tar) {
       int first=search(arr,tar,true);
       int last=search(arr,tar,false);
      return new int[]{first, last};
    }
     private int search(int[] arr, int tar, boolean first) {
          int h=arr.length-1;
       int l=0;
       int ans =-1;
       while(l<=h){
        int mid =l+(h-l)/2;
        if(arr[mid]==tar){
            ans=mid;
            if(first){
               h=mid-1;
            }
            else{
               l=mid+1;
            }
            
        }
        else if(arr[mid]<tar){
            l=mid+1;
        }
        else{
            h=mid-1;
        }
       }
       return ans; 
     }
}
