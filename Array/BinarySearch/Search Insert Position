package BinarySearch;

public class SearchInsertPosition {
    public static void main(String[] args) {
           int [] arr={1,3,5,6};
        System.out.println(searchInsert(arr,2));
    }

    public static int searchInsert(int[] arr, int tar) {
        int lo=0;
        int hi= arr.length-1;
        while (lo<=hi){
            int mid=lo+(hi-lo)/2;
            if (arr[mid]==tar) return mid;
            else if (arr[mid]<tar) {
                lo =mid+1;
            }
            else {
                hi=mid-1;
            }
        }
        return lo;
    }
}
