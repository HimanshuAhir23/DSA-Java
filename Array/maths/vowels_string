import  java.util.*;

public class vowels_string {
    public static void main(String[] args) {
     Scanner sc=new Scanner(System.in);
        System.out.println("enter a sting");
        String s=sc.nextLine();
      int ans=count_v(s);
        System.out.println("the number of vowel in string is "+ans);

    }

    public static int  count_v(String s) {
        int n=s.length();
        int count=0;
        for (int i = 0; i <n ; i++) {
            char ch=s.charAt(i);
            if(ch== 'a'||ch=='e'||ch =='i'||ch=='o'||ch=='u'){
                count++;
            }
        }
     return count;
    }
}
