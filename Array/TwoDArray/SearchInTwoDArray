package Two_D_array;

import java.util.Scanner;

public class search_in_2dArr {
    public static int[] lnrsrch(int[][] arr, int tar) {
        if (arr.length==0) return new int[]{-1, -1};

        for (int i = 0; i < arr.length; i++) {
            for (int j = 0; j <arr[i].length; j++) {
                if (arr[i][j]==tar) return new int[] {i,j};

            }

        }
        return new int[]{-1, -1};

    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n, m;
        n = sc.nextInt();
        m = sc.nextInt();
        int[][] arr = new int[n][m];
        System.out.println("enter values of the row andf column : ");

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                arr[i][j] = sc.nextInt();
            }
        }

        int[] arrr=lnrsrch(arr,2);
        for (int i = 0; i < arrr.length ; i++) {
            System.out.println(arrr[i]);
        }
    }
}
