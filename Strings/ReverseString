class Solution {
    public void reverseString(char[] s) {
        helper(s, 0);
    }

    public void helper(char[] s, int index) {

        int n = s.length;

        if(index >= n / 2) {
            return;
        }

        char temp = s[index];
        s[index] = s[n - 1 - index];
        s[n - 1 - index] = temp;

        helper(s, index + 1);
    }
}
