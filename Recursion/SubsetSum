class Solution {
    public ArrayList<Integer> subsetSums(int[] arr) {
        ArrayList<Integer> list=new ArrayList<>();
        sumSubset(0,arr,0,list);
        return list;
        
    }
    public void sumSubset(int ans ,int [] arr,int index,ArrayList<Integer> list){
        if(index==arr.length){
            list.add(ans);
            return;
        }
        int ele=arr[index];
        sumSubset(ans,arr,index+1,list);
        sumSubset(ans+ele,arr,index+1,list);
    }
}
