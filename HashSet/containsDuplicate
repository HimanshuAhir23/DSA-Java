class Solution {
    public boolean containsDuplicate(int[] nums) {
        HashSet<Integer> h=new HashSet<>();
        boolean f=true;
        for(int i=0; i<nums.length;i++){
            if(h.contains(nums[i]) ){
                return false;
            }
           else h.add(nums[i]);
        }
        return f;
        
    }
}
