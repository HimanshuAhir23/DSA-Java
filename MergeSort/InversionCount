package MergeSort;

public class InversionCount {
    static int count;
    public static void main(String[] args) {

        int[] arr = {2, 5, 1, 7, 6, 9, 3, 10, 4};

        System.out.println(inversionCount(arr));
    }
    public static int inversionCount(int [] arr){
        count=0;
        MergeSort(arr);
        return count;
    }

    public static void MergeSort(int[] arr) {
        int n = arr.length;
        if (n == 1) return;
        ;
        int[] a = new int[n / 2];
        int[] b = new int[n - n / 2];
        int idx = 0;

        for (int i = 0; i < a.length; i++) a[i] = arr[idx++];
        for (int i = 0; i < b.length; i++) b[i] = arr[idx++];

        MergeSort(a);
        MergeSort(b);
        merge(a, b, arr);
    }

    public static void merge(int[] arr1, int[] arr2, int[] arr3) {
        int m = arr1.length;
        int n = arr2.length;

        int i = 0, j = 0, k = 0;
        while (i < m && j < n) {
            if (arr1[i] <arr2[j]) arr3[k++] = arr1[i++];
            else {
                count+=(arr1.length-1);
                arr3[k++] = arr2[i++];

            }

        }
        while (i < m) {
            arr3[k] = arr1[i];
            k++;
            i++;
        }

        while (j < n) {
            arr3[k] = arr2[j];
            k++;
            j++;
        }
    }
}
