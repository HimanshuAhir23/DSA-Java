class Solution {
    public int missingNumber(int[] arr) {
            int n = arr.length ;
         int i = 0;
        while (i < arr.length) {

             if ( arr[i] < arr.length && arr[i] != arr[arr[i]]) {
                 swap(arr, i, arr[i] );
             } else {
                 i++;
             }
         }

         for (int j = 0; j < arr.length; j++) {
             if (arr[j] != j ) return j;
         }

         return n;
    }
    
    public void swap(int[] arr, int i, int idx) {
        int temp = arr[i];
        arr[i] = arr[idx];
        arr[idx] = temp;
    }
}

