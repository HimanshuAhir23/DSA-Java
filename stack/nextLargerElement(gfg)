class Solution {
    public ArrayList<Integer> nextLargerElement(int[] arr) {
        // code here
        
        Stack<Integer> st=new Stack<>();
        int n=arr.length;
        int i=n-1;
        int [] ans=new int[n];
        while(i>=0){
            
            while(!st.isEmpty() && st.peek()<=arr[i]){
                 st.pop();   
            }
            if(st.isEmpty())  ans[i] = -1;
            else ans[i] = st.peek();
            st.push(arr[i]);
            i--;
        }
        ArrayList<Integer> anss=new ArrayList<>();
        for(int j=0;j<n;j++ ){
            anss.add(ans[j]);
        }
        return anss;
    }
}
