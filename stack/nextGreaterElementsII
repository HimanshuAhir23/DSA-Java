class Solution {
    public int[] nextGreaterElements(int[] nums) {

        int n = nums.length;
        int[] ans = new int[n];

        int max = nums[0];
        int maxIdx = 0;

        for (int i = 1; i < n; i++) {
            if (nums[i] > max) {
                max = nums[i];
                maxIdx = i;
            }
        }

        Stack<Integer> st = new Stack<>();
        st.push(max);

        for (int cnt = 1; cnt <= n; cnt++) {
            int i = (maxIdx - cnt + n) % n;

            while (!st.isEmpty() && st.peek() <= nums[i]) {
                st.pop();
            }

            ans[i] = st.isEmpty() ? -1 : st.peek();

            st.push(nums[i]);
        }

        ans[maxIdx] = -1;

        return ans;
    }
}
