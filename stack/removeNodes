class Solution {
    public ListNode removeNodes(ListNode head) {

        Stack<Integer> st = new Stack<>();
        ListNode temp = head;

        while (temp != null) {

            while (!st.isEmpty() && st.peek() < temp.val) {
                st.pop();
            }

            st.push(temp.val);

            temp = temp.next;   // Missing line
        }

        temp = null;

        while (!st.isEmpty()) {
            ListNode d = new ListNode(st.pop());
            d.next = temp;
            temp = d;
        }

        return temp;
    }
}
