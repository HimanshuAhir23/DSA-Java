class Solution {
    public boolean isValid(String s) {
        int n=s.length();
        if(n%2==1)return false;
        Stack<Character> st=new Stack<>();

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            // opening bracket
            if (c == '(' || c == '[' || c == '{') {
                st.push(c);
            }
            // closing bracket
            else {
                if (st.isEmpty())
                    return false;

                char top = st.peek();

                if (sameStyle(top, c))
                    st.pop();
                else
                    return false;
            }
        }

        return st.isEmpty();
    }

    public boolean sameStyle(char open, char close) {
        if (open == '(' && close == ')')
            return true;

        if (open == '[' && close == ']')
            return true;

        if (open == '{' && close == '}')
            return true;

        return false;
    }
}
