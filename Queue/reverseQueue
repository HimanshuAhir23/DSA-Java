
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Queue<Integer> q= new LinkedList<>();
		q.add(1);
		q.add(2);
		q.add(3);
		q.add(4);
		q.add(5);
		
		reverse(q);
	}
	public static void reverse(Queue<Integer> q){
	    Stack<Integer> st = new Stack<>();
	     
	   int n= q.size();
	   for(int i =0; i<n ;i++){
	       st.push(q.remove());
	   }
	   
	   for(int i=0; i<n; i++){
	       q.add(st.pop());
	   }
	    
	   for(int i=0;i<n;i++){ 
	  System.out.print(q.peek()+" ");
	   q.add(q.remove());    
	       
	   }
	    
	}
}
