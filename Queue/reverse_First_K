class Solution {
	public Queue<Integer> reverseFirstK(Queue<Integer> q, int k) {
		int s = q.size();
		if (s < k)return q;
		
		if (s == k) {
			Stack<Integer> st = new Stack<>();
		
			
			while (!q.isEmpty()) {
				st.push(q.remove());
			}
			while (!st.isEmpty()) {
				q.add(st.pop());
			}
			return q;
		}
		
		Stack<Integer> st = new Stack<>();
		
		int j = 0;
		while (j != k) {
			st.push(q.remove());
			j++;
			
		}
		
		while (!st.isEmpty()) {
			q.add(st.pop());
		}
		
		for (int i = 0; i<s - k; i++) {
			q.add(q.remove());
			
		}
		return q;
		
	}
}
