
class Queue {
    int[] arr;
    int front;
    int rear;
    int size;

    Queue(int size) {
        arr = new int[size];
        front = 0;
        rear = -1;
        this.size = size;
    }

    void enqueue(int x) {
        if (rear == size - 1) {
            System.out.println("Queue is Full");
            return;
        }

        rear++;
        arr[rear] = x;
    }

    int dequeue() {
        if (front > rear) {
            System.out.println("Queue is Empty");
            return -1;
        }

        int x = arr[front];
        front++;
        return x;
    }

    int peek() {
        if (front > rear) {
            System.out.println("Queue is Empty");
            return -1;
        }

        return arr[front];
    }

    boolean isEmpty() {
        return front > rear;
    }
}
