package Queue;

class Node{
    int val;
    Node next;
    Node(int val){
        this.val=val;
    }
}
class Queue_linkedList{
    Node head ;
    Node tail;

    //add, remove , peek
    public    void add(int val){
        Node temp= new Node(val);
        if(head==null){
             head =temp;
             tail=temp;
        }
        else {
            tail.next=temp;
            tail=temp;
        }
    }
    public  void remove(){
        if(head.next!=null){
            head=head.next;

        }
        else{
            head=null;
        }
    }
    public  int  peek(){
        if(head!=null){
            return head.val;
        }
        return -1;
    }

    void display(){
        Node temp=head;
        while (temp!=null){
            System.out.print(temp.val +" ");
            temp=temp.next;
        }
        System.out.println();
    }


}

public class ImplementingThroughLinkedList {
    public static void main(String[] args) {
        Queue_linkedList q=new Queue_linkedList();
        q.add(10);
        q.add(20);
        q.add(30);
        q.add(40);
        q.add(50);
        q.display();
        q.remove();
        
        q.display();
        q.add(60);
        q.display();
    }
}
