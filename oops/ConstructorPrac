package objectOrientedProgramming;

public class ConstructorPrac {
    public  static  class Car{
        String name;
        int price;
        String Company;

        Car(){
            name="Harrier";
            price=2800000;
            Company="TATA";
        }
        Car(String s,int p,String c){ //paramterized constructor
            name =s;
            price=p;
            Company=c;
        }
        Car(int price,String Company,String name){//paramterized constructor with diff order of para
            this.name =name;
            this.price=price;
            this.Company=Company;
        }
        void display() {
            System.out.println("Name: " + name);
            System.out.println("Price: " + price);
            System.out.println("Company: " + Company);
        }
    }
    public static void main(String[] args) {
        Car c1=new Car();
        c1.display();
        Car c2=new Car(200000,"Mahindra","Scorpio");
        c2.display();
        Car c3=new Car("creta",1800000,"Hyundai");
        c3.display();
    }
}
