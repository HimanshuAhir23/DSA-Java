class Solution {
    public ListNode[] splitListToParts(ListNode head, int k) {

        // Step 1: Count nodes
        int count = 0;
        ListNode temp = head;

        while (temp != null) {
            count++;
            temp = temp.next;
        }

        int baseSize = count / k;
        int extra = count % k;

        ListNode[] ans = new ListNode[k];
        ListNode current = head;

        for (int i = 0; i < k; i++) {

            if (current == null) {
                ans[i] = null;
                continue;
            }

            ans[i] = current;

            int partSize = baseSize + (extra > 0 ? 1 : 0);

            if (extra > 0)
                extra--;

            // Move to the last node of this part
            for (int j = 1; j < partSize; j++) {
                current = current.next;
            }

            // Cut the list
            ListNode nextPart = current.next;
            current.next = null;
            current = nextPart;
        }

        return ans;
    }
}
